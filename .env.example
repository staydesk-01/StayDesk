# =============================================================================
# StayDesk AI: environment (single Next.js app).
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Everything here is read server-side only, except NEXT_PUBLIC_* values.
# =============================================================================

# ---- Required for local development ------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/staydesk      (docker compose up -d starts one)
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/staydesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/staydesk
# Public URL of this app. Base for email links and Twilio callback URLs.
# Local: http://localhost:3000   With ngrok: your https://xxxx.ngrok-free.app   Production: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Deployment version (update notifications) ---------------------------------------------
# Optional. Identifies the deployed build so open browser tabs can detect a newer one. Normally leave blank:
# Vercel/Railway commit SHA or deployment id is used automatically, else a unique per-build stamp.
# Only needed to force a value at BUILD time (it is baked into the build, so changing it at runtime has no effect).
APP_BUILD_ID=

# ---- Auth ----------------------------------------------------------------------------
# Signs session cookies. REQUIRED in production (>=32 random chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- AI ------------------------------------------------------------------------------
# Without OPENAI_API_KEY the built-in deterministic agent answers (fully working for demos/tests).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Twilio (only needed for real phone calls) -----------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164, e.g. +14155550123. `npm run seed` attaches it to the demo business.
TWILIO_PHONE_NUMBER=
# Only if Twilio must reach a different URL than NEXT_PUBLIC_APP_URL (leave blank normally).
PUBLIC_BASE_URL=
# DEV ONLY: skip webhook signature checks (ignored in production). Prefer ngrok + real signatures.
TWILIO_SKIP_SIGNATURE=false
TELEPHONY_PROVIDER=twilio

# ---- Email alerts (optional) -------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=StayDesk <alerts@yourdomain.com>

# ---- External voice agents (optional, experimental) ----------------------------------------
VOICE_PROVIDER=twilio_gather
VOICE_SIP_URI=
RETELL_API_KEY=
VAPI_WEBHOOK_SECRET=
# Shared secret external agents send as `x-agent-secret` to /api/agent/* and /api/voice/*.
AGENT_TOOL_SECRET=

# ---- Feature flags (all optional; defaults shown) -----------------------------------------------
# Remember returning callers per business (minimal data for medical businesses). Erase via DELETE /api/customers/:id.
FEATURE_CUSTOMER_MEMORY=true
# Say "Welcome back" to recognised numbers (never a name or past details before the caller verifies).
FEATURE_RETURNING_GREETING=false
# Store request -> actions -> real outcomes -> failures -> next steps on every call.
FEATURE_COMPLETION_TRACKING=true
# If one turn errors, apologise and keep the call going instead of hanging up.
FEATURE_RESILIENT_TURNS=true
# Apply the two settings below to speech recognition. Untested on live calls: change and listen before relying on it.
FEATURE_VOICE_TUNING=false
VOICE_SPEECH_TIMEOUT=auto
VOICE_NO_INPUT_SECONDS=6

# ---- Telephony core (all optional, all OFF by default; see docs/TELEPHONY.md) -----------------------------
FEATURE_TELEPHONY_CORE=false
FEATURE_SIP_GATEWAY=false
FEATURE_OUTBOUND_CALLING=false
# 32+ random characters. Required before provider credentials can be saved (they are encrypted with it). Never commit.
TELEPHONY_SECRET_KEY=
# 24+ random characters. Bearer token for the outbound scheduler endpoint POST /api/outbound/dispatch.
CRON_SECRET=
VOICE_TURN_TIMEOUT_MS=8000

# ---- Tests only (npm test WIPES this database) -----------------------------------------------
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/staydesk_test
